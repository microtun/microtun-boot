/* @generated by microtun-boot-esp/build.rs from chips/esp32c3. */
MEMORY
{
    BOOT_INFO (RW) : ORIGIN = @BOOT_INFO_ADDRESS@, LENGTH = @BOOT_INFO_SIZE@
}

/* microtun boot ESP32-C3 application linker contract; link after esp-hal's
 * linkall.x. build.rs substitutes the BOOT_INFO region from the
 * chip description.
 *
 * Boot info is the last 80 bytes of the reclaimed bootloader RAM, immediately
 * below ROM data. Startup must neither load nor zero this record;
 * .dram2_uninit allocations must end before it.
 */

EXTERN(_microtun_boot_boot_info_storage);
SECTIONS {
  .microtun_boot_boot_info (NOLOAD) : ALIGN(16)
  {
    _microtun_boot_boot_info_start = ABSOLUTE(.);
    KEEP(*(.microtun_boot_boot_info));
    _microtun_boot_boot_info_end = ABSOLUTE(.);
  } > BOOT_INFO
}

ASSERT(SIZEOF(.microtun_boot_boot_info) == LENGTH(BOOT_INFO), "boot info storage must fill its reservation");
ASSERT(ORIGIN(dram2_seg) + LENGTH(dram2_seg) == _microtun_boot_boot_info_end,
       "boot info requires the expected ESP32-C3 reclaimed RAM map");
ASSERT(ADDR(.dram2_uninit) + SIZEOF(.dram2_uninit) <= _microtun_boot_boot_info_start,
       "reclaimed RAM allocations overlap microtun boot boot info (reserve 80 bytes)");
